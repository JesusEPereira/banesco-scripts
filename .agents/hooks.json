{
  "banesco-guardrails": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File D:\\WKESPEREIRA\\D\\Scripts\\.agents\\hooks\\safety-gate.ps1",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File D:\\WKESPEREIRA\\D\\Scripts\\.agents\\hooks\\post-tool-ps1.ps1",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File D:\\WKESPEREIRA\\D\\Scripts\\.agents\\hooks\\stop-format-linter.ps1",
        "timeout": 15
      }
    ]
  }
}